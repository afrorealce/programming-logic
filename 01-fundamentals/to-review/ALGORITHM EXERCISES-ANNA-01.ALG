Algoritmo "algorithm exercises-Anna-02"

Var
 ano_atual,  ano_nasc, idade:Inteiro


Inicio
      Escreva("Em que ano nos estamos? ")
      Leia(ano_atual)
      Escreva("Em que ano eu nasci? ")
      Leia(ano_nasc)
      idade <- ano_atual - ano_nasc
      Escreval("Minha idade sera", idade)
      
      


Fimalgoritmo