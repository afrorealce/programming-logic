Algoritmo "somadorNumerico"

Var

 cont, N, S : inteiro

Inicio
      cont <- 1
      S <- 0
      Enquanto (cont <= 5) faca
           Escreval ("Digite o ", cont, "o. Valor : ")
           Leia (N)
          S  <- S + N
           cont <- cont + 1
      FimEnquanto
      EscrevaL ("A soma de todos os valors foi! ", S)
fimalgoritmo